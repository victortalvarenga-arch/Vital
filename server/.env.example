# Copie para .env e ajuste.

PORT=3333
CORS_ORIGIN=http://localhost:5173
TZ_ESTUDIO=America/Sao_Paulo

# Banco. Em desenvolvimento é o Postgres da sua máquina; em produção, a URL do
# provedor gerenciado (Neon, Supabase). Só esta linha muda entre os dois — nunca
# o código.
DATABASE_URL=postgresql://postgres:vitaldev@localhost:5432/vital

# Senha do painel. Vazio = painel aberto (só use assim em desenvolvimento).
ADMIN_TOKEN=

# WhatsApp
#   manual → não envia nada; a fila vira links wa.me para clicar. Use isto agora.
#   meta   → API oficial (Cloud API). Exige conta aprovada e templates cadastrados.
WHATSAPP_PROVIDER=manual
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v21.0
