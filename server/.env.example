# Copie para .env e ajuste.

PORT=3333
CORS_ORIGIN=http://localhost:5173
TZ_EMPRESA=America/Sao_Paulo

# Banco — dois usuários, de propósito.
#
# DATABASE_URL é a aplicação: roda como `vital_app`, sem superusuário. Isso é o
# que faz o isolamento entre empresas funcionar, porque o Postgres ignora
# Row-Level Security para superusuário.
#
# DATABASE_ADMIN_URL é só para as migrations, que precisam criar tabela. Em
# produção é a credencial de deploy, nunca a da aplicação.
#
# O banco é um branch de desenvolvimento da Neon (README.md). Use a conexão
# DIRETA: o host NÃO pode ter `-pooler` — a empresa fica presa à conexão, e um
# pooler em modo transação a entregaria a outra requisição.
#   ADMIN: a string do `neondb_owner`, como a Neon dá.
#   URL:   mesmo host e banco; usuário `vital_app` e uma senha que você inventa
#          (a migration cria o papel, o `setup` grava a senha).
DATABASE_URL=postgresql://vital_app:SENHA_QUE_VOCE_INVENTA@ep-xxxx.regiao.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_ADMIN_URL=postgresql://neondb_owner:SENHA_DA_NEON@ep-xxxx.regiao.aws.neon.tech/neondb?sslmode=verify-full

# Libera reset, seed (contas de senha conhecida) e senha-app num banco que não é
# localhost. SÓ no branch de desenvolvimento — nunca em produção.
VITAL_BANCO_DESCARTAVEL=sim

# O painel usa login com senha (argon2) e sessão em cookie. Não há mais token
# no .env: os usuários ficam na tabela `users`, e o primeiro acesso se cria
# pela própria tela enquanto a empresa não tiver ninguém cadastrado.

# WhatsApp
#   manual → não envia nada; a fila vira links wa.me para clicar. Use isto agora.
#   meta   → API oficial (Cloud API). Exige conta aprovada e templates cadastrados.
WHATSAPP_PROVIDER=manual
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v21.0

# Jobs (lembretes, fechamento do caixa, Google/Instagram). Por padrão a API os
# roda; `nao` desliga, para quando eles rodam num processo próprio
# (`npm run jobs`). Mesmo ligados nos dois, só um roda de cada vez.
JOBS_NA_API=

# Atrás de proxy (Vercel, nginx), o Host real chega em X-Forwarded-Host — e é
# ele que diz de qual empresa é a requisição. Use o número de proxies
# confiáveis, normalmente 1. Deixe vazio quando a API atende direto: ligado sem
# proxy na frente, qualquer cliente escolhe de qual empresa quer ser.
#
# Vale também para o limite de chamadas abaixo, que conta por IP: sem
# TRUST_PROXY atrás de um proxy, todo mundo vira o mesmo IP (o do proxy) e o
# limite barra cliente de verdade.
TRUST_PROXY=

# Limite de chamadas nas rotas abertas do site (/evento, /agendar,
# /identificar). Ligado por padrão; `off` desliga — o que faz sentido quando a
# proteção já existe na borda (Cloudflare, WAF) e é como a suíte roda.
# Os tetos estão em `src/routes/publico.js`; o porquê, em `src/lib/limite.js`.
RATE_LIMIT=on

# Quantos dias de visita crua ficam de pé antes de o dia virar uma linha de
# contagens em `funil_diario`. A tela do back-office oferece até 90 dias, então
# abaixo disso ela passaria a ler só o resumo. Ver ARQUITETURA.md.
FUNIL_RETENCAO_DIAS=90

# Onde as fotos moram. `server/uploads/` não é versionado, então numa máquina
# recém clonada os arquivos não existem — com a variável preenchida, o seed
# grava a URL do bucket e `POST /api/uploads` sobe direto para lá; sem ela,
# cai em `server/uploads/<empresa>/`, em disco (só funciona com hospedagem de
# disco persistente — ver ROADMAP.md, "Hospedagem"). Sem barra no fim; a
# pasta da empresa é acrescentada por quem usa a variável.
UPLOADS_BASE_URL=https://pub-474ec1f20c2c443cba21f1bcf59fd2fd.r2.dev

# E-mail (por enquanto, só o link de "Esqueci minha senha").
#   console → não envia: imprime no terminal do `npm run dev`. Use isto agora.
#             Em produção não imprime o conteúdo (o link troca a senha).
#   resend  → Resend (plano grátis, 3.000/mês). Exige o domínio verificado lá;
#             sem isso, só entrega para o e-mail do dono da conta Resend.
EMAIL_PROVIDER=console
RESEND_API_KEY=
# Quem aparece como remetente, num domínio verificado no Resend.
# Ex.: Vital <nao-responda@seudominio.com.br>
EMAIL_REMETENTE=

# Chave que destrava o primeiro acesso do back-office da Vital (vital.html#equipe)
# enquanto a plataforma não tem ninguém da equipe. Em produção é obrigatória:
# sem ela a rota fica desligada, porque o banco nasce vazio e quem chegasse
# antes viraria administrador. Em desenvolvimento pode ficar vazia.
# Gere com o mesmo comando do CONEXOES_SEGREDO, abaixo.
VITAL_CHAVE_PRIMEIRO_ACESSO=

# Conexões da empresa com Google (avaliações) e Instagram (publicações).
# Sem as variáveis, o painel mostra o botão desligado com "ainda não ativada".
# Passo a passo dos consoles do Google e da Meta: ROADMAP.md, Bloco 6b.
#
# CONEXOES_SEGREDO assina o retorno da autorização e cifra os tokens no banco.
# 32+ caracteres aleatórios; gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Trocar este valor invalida todos os tokens guardados (as empresas reconectam).
CONEXOES_SEGREDO=
# Onde o Google e a Meta devolvem a pessoa — o endereço exato cadastrado nos
# dois consoles, sem barra no fim. O caminho (/api/oauth/<provedor>/retorno)
# é acrescentado pelo código. Em desenvolvimento, o Vite (5173) repassa para a
# API. A Meta só aceita HTTPS: para testar o Instagram local, use um túnel.
CONEXOES_RETORNO_URL=http://localhost:5173
# Google Cloud → APIs e serviços → Credenciais → ID do cliente OAuth (app da Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Meta for Developers → o app → Instagram → Configuração da API com login
# comercial do Instagram.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Credencial de ESCRITA no bucket (a URL acima só serve para LER, é pública).
# Painel Cloudflare → R2 → o bucket → Settings → "Manage API Tokens" → criar
# um token com permissão "Object Read & Write", escopado a este bucket só.
# As quatro precisam existir juntas — falta uma, `uploads.js` cai para disco
# local com um aviso no console.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
