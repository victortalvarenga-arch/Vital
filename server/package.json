{
  "name": "estudio-agenda-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed": "node src/seed.js",
    "reset": "node src/reset.js && npm run seed",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "senha-app": "node src/senha-app.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "pg": "^8.23.0"
  },
  "allowScripts": {
    "argon2@0.45.1": true
  }
}
