{
  "name": "estudio-agenda-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed": "node src/seed.js",
    "reset": "node -e \"for(const f of['db/estudio.db','db/estudio.db-wal','db/estudio.db-shm'])require('fs').rmSync(f,{force:true})\" && npm run seed"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^3.0.3"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
