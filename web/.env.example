# Em desenvolvimento o Vite já faz proxy de /api para localhost:3333.
# Só preencha se for apontar para outro servidor.
# VITE_API_URL=http://localhost:3333/api

# Precisa bater com ADMIN_TOKEN do servidor.
# Atenção: isto vai para o bundle. Enquanto o site público e o painel
# estiverem no mesmo build, não publique com token preenchido.
# VITE_ADMIN_TOKEN=
